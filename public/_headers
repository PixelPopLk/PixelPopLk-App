# 0. Sitemaps & Search Engine Crawlers (Googlebot, Bingbot etc.)
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: all
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, s-maxage=3600

/robots.txt
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: all
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, s-maxage=3600

# 1. Project එකේ Build වෙන JS, CSS, Web Fonts ( assets / sub-folders එක්කම)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 2. Local වගේ වෙනම තියෙන Images/Icons මොනවා හරි තියෙනවා නම්
/images/*
  Cache-Control: public, max-age=31536000, immutable

# 3. HTML Pages (අලුතෙන් Site එක Update කරද්දී Visitors ලට එකපාර පෙන්නන්න)
/*
  Cache-Control: public, max-age=0, must-revalidate
